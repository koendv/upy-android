<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Used by the csi (camera) module inside :engine, not the main
         process - see project memory / SESSION_STATE.yaml. required
         false: most Android devices have a camera, but this app should
         not refuse to install on one that genuinely lacks any. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:label="upy-android"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Separate process for crash isolation (see project memory:
             single-APK, engine in a separate process). exported="false"
             is correct and sufficient here: same-app-only binding,
             no cross-app signature permission needed. -->
        <service
            android:name=".EngineService"
            android:process=":engine"
            android:exported="false" />

        <!-- adb-driven one-shot MicroPython exec. See AdbExecProvider.kt. -->
        <provider
            android:name=".AdbExecProvider"
            android:authorities="${applicationId}.exec"
            android:exported="true" />

        <!-- litert-api (android.litert module) pulls in WorkManager
             transitively; its own androidx.startup auto-init is purely
             local (SQLite job-scheduling), never contacts a server, but
             this app has no use for it and no other Play Services
             dependency anywhere. Stripped for cleanliness, not because
             it is unsafe. See app/build.gradle.kts's litert-api
             dependency comment. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                tools:node="remove" />
        </provider>
    </application>

</manifest>
