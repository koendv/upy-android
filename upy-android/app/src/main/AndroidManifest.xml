<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Used by the camera module inside :engine, not the main
         process - see project memory / SESSION_STATE.yaml. required
         false: most Android devices have a camera, but this app should
         not refuse to install on one that genuinely lacks any. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- umqtt (Part 7) is the first module in this project that needs a
         real network socket: HiveMQ MQTT Client opens a plain TCP
         connection to a user-specified broker. No other module needs
         this (mediastore/fileprovider/litert/tf/rt are all purely
         on-device). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- android.location; asked on first use by a script. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:label="upy"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false"
        android:theme="@style/Theme.Upy">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Share target: files or text shared from other apps are
                 saved in the VFS root, see MainActivity.saveShared().
                 singleTask: a share reuses the running upy instead of
                 starting a second one in the sending app's task. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!-- Separate process for crash isolation (see project memory:
             single-APK, engine in a separate process). exported="false"
             is correct and sufficient here: same-app-only binding,
             no cross-app signature permission needed. -->
        <service
            android:name=".EngineService"
            android:process=":engine"
            android:exported="false" />

        <!-- android.fileprovider (Part 7). Exposes the same VFS root
             Explorer/Import/Export already treat as user-visible via a
             content:// URI, for sharing a script-produced file into
             another app's ACTION_SEND target. exported="false" plus
             grantUriPermissions is the standard FileProvider pattern:
             access is per-URI, granted only to whichever app the share
             chooser hands the URI to, not a blanket cross-app grant. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- adb-driven one-shot MicroPython exec. See AdbExecProvider.kt. -->
        <provider
            android:name=".AdbExecProvider"
            android:authorities="${applicationId}.exec"
            android:exported="true" />
    </application>

</manifest>
