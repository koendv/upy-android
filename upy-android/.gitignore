# External reference clones (micropython, termux-app, micro-repl) — not
# this project's own source. Re-clone via the commands documented in
# SESSION_STATE.yaml (upstream_sources section).
upstream/

# Build outputs / caches
build/
app/build/
app/.cxx/
.gradle/
.kotlin/
native-bringup/build-embed/
native-bringup/micropython_embed/
native-bringup/embed-arm64

# Regenerated from native-bringup/micropython_embed/ by the Dockerfile's
# own build stage / the local dev workflow's own cp step (see
# apply-overrides.sh, Dockerfile's header comment) -- not embedded in
# this repo's git history either, same ephemeral treatment as
# native-bringup/micropython_embed/ above.
app/src/main/cpp/micropython_embed/

# ulab (numpy/scipy-like extension): pristine upstream source, fetched
# fresh at the pinned ULAB_SHA by the Dockerfile (git clone + cp), never
# vendored into this repo's own git history (see Dockerfile's own header
# comment and tools/sync-upy-android.sh, which strips this same
# directory back out of a fresh archive). ulab_config.h (OUR OWN file)
# already lives elsewhere in my-overrides/ and is unaffected.
native-bringup/my-overrides/ulab/

# OpenMV imlib/common/modules: the 68 files below are confirmed
# byte-identical to a real OpenMV upstream path (see
# tools/docker/openmv-manifest.tsv), fetched fresh at the pinned
# OPENMV_SHA by the Dockerfile, same "not vendored into this repo's own
# git history" treatment as ulab/ above. The remaining ~14 files in this
# same directory (board_config.h, arm_math.h, link_stubs.c, etc.) are
# OUR OWN replacement headers/glue with no upstream equivalent and stay
# tracked -- hence a per-file list here, not a whole-directory ignore.
