# External reference clones (micropython, termux-app, micro-repl) — not
# this project's own source. Re-clone via the commands documented in
# SESSION_STATE.yaml (upstream_sources section).
upstream/

# Build outputs / caches
build/
app/build/
app/.cxx/
.gradle/
.kotlin/
native-bringup/build-embed/
native-bringup/micropython_embed/
native-bringup/embed-arm64

# Regenerated from native-bringup/micropython_embed/ by the Dockerfile's
# own build stage / the local dev workflow's own cp step (see
# apply-overrides.sh, Dockerfile's header comment) -- not embedded in
# this repo's git history either, same ephemeral treatment as
# native-bringup/micropython_embed/ above.
app/src/main/cpp/micropython_embed/

# Pristine upstream source (ulab, OpenMV imlib/common/modules), fetched
# by native-bringup/populate-vendor.sh from upstream/ (pinned in
# upstream.properties, see native-bringup/openmv-manifest.tsv), never
# vendored into this repo's own git history. OUR OWN replacement/glue files with no upstream
# equivalent (ulab_config.h, board_config.h, arm_math.h, link_stubs.c,
# etc.) live in the sibling my-overrides/ulab/ and my-overrides/openmv/
# and stay tracked.
native-bringup/vendor/

# LiteRT prebuilt .so files, extracted from the litert AAR on every
# build (build.gradle.kts's extractLitert task). The LiteRT headers next
# to them (litert/include/) ARE tracked, see litert/README.md.
app/src/main/cpp/litert/lib/

# libLiteRtClGlAccelerator.so, staged here by stageLitertDelegate (AGP scans
# jniLibs/<abi>/ by convention) -- same ephemeral/regenerated-by-script
# treatment as app/src/main/cpp/litert/ above.
app/src/main/jniLibs/

# NOTICE.md copied here by build.gradle.kts's own copyNotice task (shown
# in-app via AboutScreen.kt) -- the repo-root NOTICE.md is the one
# tracked copy, this is regenerated on every build.
app/src/main/assets/

# Machine-specific (contains a local absolute SDK path)
local.properties

# Claude Code session-local tooling artifacts, not project source
.claude/
resumes

# Loose demo artifact, not source (re-add explicitly if you want it kept)
upy_version_banner.png
